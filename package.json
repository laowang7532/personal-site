{
  "name": "personal-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "小王同学的个人网站 · Vite + Vue 3 + TypeScript + UnoCSS 多页构建",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen": "node scripts/gen-entries.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "new-post": "node scripts/new-post.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
